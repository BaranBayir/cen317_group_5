@API_HostAddress = https://localhost:7205
@csrfToken = REPLACE_WITH_REQUEST_TOKEN
@addressId = 1

# Cookie'leri istekler arasında koruyun. CSRF cevabındaki requestToken'ı yukarıya yapıştırın.
GET {{API_HostAddress}}/api/auth/csrf
Accept: application/json

###

POST {{API_HostAddress}}/api/auth/register
Content-Type: application/json
X-CSRF-TOKEN: {{csrfToken}}

{
  "firstName": "Ada",
  "lastName": "Yilmaz",
  "email": "ada@example.com",
  "password": "ExamplePass1!",
  "confirmPassword": "ExamplePass1!"
}

###

POST {{API_HostAddress}}/api/auth/login
Content-Type: application/json
X-CSRF-TOKEN: {{csrfToken}}

{
  "email": "ada@example.com",
  "password": "ExamplePass1!",
  "rememberMe": false
}

###

GET {{API_HostAddress}}/api/auth/me
Accept: application/json

###

GET {{API_HostAddress}}/api/addresses
Accept: application/json

###

GET {{API_HostAddress}}/api/addresses/{{addressId}}
Accept: application/json

###

POST {{API_HostAddress}}/api/addresses
Content-Type: application/json
X-CSRF-TOKEN: {{csrfToken}}

{
  "title": "Ev",
  "city": "Istanbul",
  "district": "Kadikoy",
  "addressLine": "Ornek Mahallesi, Ornek Sokak No: 10 Daire: 2"
}

###

PUT {{API_HostAddress}}/api/addresses/{{addressId}}
Content-Type: application/json
X-CSRF-TOKEN: {{csrfToken}}

{
  "title": "Is",
  "city": "Istanbul",
  "district": "Besiktas",
  "addressLine": "Ornek Caddesi No: 20 Daire: 3"
}

###

DELETE {{API_HostAddress}}/api/addresses/{{addressId}}
X-CSRF-TOKEN: {{csrfToken}}

###

# Login sonrasında GET /api/auth/csrf ile yeni token alıp csrfToken değişkenini güncelleyin.
POST {{API_HostAddress}}/api/auth/logout
X-CSRF-TOKEN: {{csrfToken}}

###
