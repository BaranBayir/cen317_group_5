  "categoryItemId": 1,
  "quantity": 1,
  "optionIds": [],
  "addonIds": []
}

  ###
POST {{API_HostAddress}}/api/cart/items
Content-Type: application/json
X-CSRF-TOKEN: {{csrfToken}}

{
  "categoryItemId": 1,
  "quantity": 1,
  "optionIds": [999],
  "addonIds": []
}

  ###
POST {{API_HostAddress}}/api/cart/items
Content-Type: application/json
X-CSRF-TOKEN: {{csrfToken}}

{
  "categoryItemId": 1,
  "quantity": 1,
  "optionIds": [1],
  "addonIds": [999]
}
###
POST {{API_HostAddress}}/api/cart/items
Content-Type: application/json
X-CSRF-TOKEN: {{csrfToken}}

{
  "categoryItemId": 1,
  "quantity": 1,
  "optionIds": [1, 2],
  "addonIds": []
}
###
PUT {{API_HostAddress}}/api/cart/items/1
